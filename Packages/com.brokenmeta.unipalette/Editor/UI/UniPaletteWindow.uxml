<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:Style src="/Packages/com.brokenmeta.unipalette/Editor/UI/UniPaletteWindow.uss" />
    <ui:VisualElement name="palette-root">
        <ui:VisualElement name="what-section" class="up-section">
            <ui:Label text="What — What to create" class="up-section-title"/>
            <ui:VisualElement name="what-shell" class="up-field-shell up-field-shell--active">
                <ui:Image name="what-icon" class="up-field-icon"/>
                <ui:TextField name="what-input" class="up-field"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="where-section" class="up-section">
            <ui:Label text="Where — Destination" class="up-section-title"/>
            <ui:VisualElement name="where-shell" class="up-field-shell">
                <ui:Image name="where-icon" class="up-field-icon" />
                <ui:TextField name="where-input" class="up-field"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:ListView name="results-list" fixed-item-height="56" selection-type="Single" focusable="false" class="up-results"/>
        <ui:VisualElement name="palette-footer" class="up-footer">
            <ui:VisualElement name="action-info">
                <ui:Label name="action-preview" text="Select what and where to create" class="up-action"/>
                <ui:Label name="action-description" text="Ready for input" class="up-hint"/>
            </ui:VisualElement>
            <ui:Label name="confirm-hint" text="Enter ↵" class="up-key"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
