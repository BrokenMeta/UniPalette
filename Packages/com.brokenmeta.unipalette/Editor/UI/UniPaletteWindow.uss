
/* ========================================
   UniPalette — Theme
   ======================================== */

#palette-root {
    --up-bg: #212121;
    --up-surface: #2F2F2F;
    --up-hover: #383838;
    --up-selected: #424242;

    --up-text: #ECECEC;
    --up-text-muted: #A1A1AA;
    --up-border: #3A3A3A;
    --up-accent: #8AB4F8;

    flex-grow: 1;
    padding: 14px;

    background-color: var(--up-bg);
    color: var(--up-text);
}

/* ========================================
   Sections
   ======================================== */

.up-section {
    margin-bottom: 12px;
}

.up-section-title {
    margin-bottom: 6px;

    color: var(--up-text-muted);
    font-size: 11px;
}

/* ========================================
   Search Fields
   ======================================== */

.up-field-shell {
    flex-direction: row;
    align-items: center;

    height: 42px;
    padding: 0 12px;

    background-color: var(--up-surface);

    border-radius: 9px;
    border-width: 1px;
    border-color: transparent;
}

.up-field-shell--active {
    border-color: var(--up-accent);
}

.up-field-icon {
    width: 16px;
    height: 16px;

    margin-right: 10px;
    opacity: 0.75;
}

.up-field {
    flex-grow: 1;
    min-width: 0;

    margin: 0;
    padding: 0;

    font-size: 14px;
    color: var(--up-text);
}

/* Override Unity's built-in TextField visuals */

.up-field .unity-text-field__input,
.up-field .unity-base-text-field__input {
    flex-grow: 1;

    margin: 0;
    padding: 0;

    background-color: transparent;

    border-width: 0;
    border-radius: 0;

    color: var(--up-text);
    font-size: 14px;
}

/* ========================================
   Search Results
   ======================================== */

.up-results {
    flex-grow: 1;
    min-height: 100px;
    max-height: 240px;

    background-color: transparent;
    border-width: 0;
}

.up-results .unity-list-view__item {
    padding: 4px;
    border-radius: 8px;
    background-color: transparent;
}

.up-results .unity-list-view__item:hover {
    background-color: var(--up-hover);
}

.up-results .unity-collection-view__item--selected,
.up-results .unity-collection-view__item--selected:hover {
    background-color: var(--up-selected);
}

.up-result {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;

    padding: 4px 8px;
}

.up-result-icon {
    width: 20px;
    height: 20px;

    margin-right: 12px;
}

.up-result-content {
    flex-grow: 1;
    min-width: 0;
}

.up-result-name {
    color: var(--up-text);
    font-size: 13px;
    -unity-font-style: bold;
}

.up-result-description {
    margin-top: 3px;

    color: var(--up-text-muted);
    font-size: 11px;
}

/* ========================================
   Footer / Action Preview
   ======================================== */

.up-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;

    padding-top: 12px;
    margin-top: 8px;

    border-top-width: 1px;
    border-top-color: var(--up-border);
}

.up-action {
    color: var(--up-text);
    font-size: 12px;
}

.up-hint {
    color: var(--up-text-muted);
    font-size: 11px;
}

/* Keyboard shortcut hint */

.up-key {
    padding: 4px 7px;

    background-color: var(--up-surface);
    border-radius: 5px;

    color: var(--up-text-muted);
    font-size: 11px;
}
