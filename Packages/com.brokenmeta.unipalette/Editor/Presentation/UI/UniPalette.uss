.unipalette {
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
    overflow: hidden;
    background-color: var(--appui-backgrounds-100);
    color: var(--appui-foregrounds-100);
}

.unipalette__header {
    flex-direction: row;
    align-items: center;
    margin: 10px 12px 0 8px;
    flex-shrink: 0;
    height: 38px;
}

.unipalette__back {
    width: 28px;
    height: 28px;
    margin-right: 8px;
    flex-shrink: 0;
}

.unipalette__context-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
}

.unipalette__context-text {
    margin-left: 8px;
    margin-right: 8px;
    flex-grow: 1;
    min-width: 0;
}

.unipalette__context-title {
    font-size: 13px;
    -unity-font-style: bold;
}

.unipalette__context-path {
    font-size: 10px;
    color: var(--appui-foregrounds-50);
}

.unipalette__context-title, .unipalette__context-path {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.unipalette__mode {
    font-size: 10px;
    padding: 3px 7px;
    border-radius: 4px;
    background-color: var(--appui-backgrounds-200);
    color: var(--appui-foregrounds-200);
    flex-shrink: 0;
}

.unipalette__search {
    margin: 10px 12px 8px 12px;
    flex-shrink: 0;
}

.unipalette__results-heading {
    flex-direction: row;
    align-items: center;
    margin: 0 16px 5px 16px;
    flex-shrink: 0;
}

.unipalette__results-title {
    font-size: 11px;
    -unity-font-style: bold;
}

.unipalette__results-count {
    font-size: 10px;
    margin-left: 6px;
    padding: 1px 5px;
    border-radius: 3px;
    background-color: var(--appui-backgrounds-200);
}

.unipalette__mock-label {
    font-size: 10px;
    color: var(--appui-foregrounds-50);
    flex-grow: 1;
    -unity-text-align: middle-right;
}

.unipalette__results {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
    min-width: 0;
    margin: 0 8px 4px 8px;
}

.unipalette__row {
    height: 44px;
    padding: 4px 8px;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    border-radius: 4px;
}

.unipalette__row .appui-listview-item__thumbnail {
    width: 20px;
    height: 20px;
    background-color: rgba(0, 0, 0, 0);
    border-radius: 0;
}

.unipalette__row .appui-listview-item__container {
    min-width: 0;
    margin: 0 8px;
}

.unipalette__row .appui-listview-item__title {
    font-size: 12px;
    width: 100%;
}

.unipalette__row .appui-listview-item__subtitle {
    font-size: 10px;
    width: 100%;
    margin-top: 1px;
}

.unipalette__row-indicator {
    font-size: 12px;
    color: var(--appui-foregrounds-50);
    min-width: 16px;
    -unity-text-align: middle-center;
}

/* Persist selection contrast while the text input owns keyboard focus. */
.unipalette__results .unity-collection-view__item--selected.unipalette__row {
    background-color: var(--appui-accent-100);
    border-left-color: var(--appui-accent-25);
}

.unipalette__results .unity-collection-view__item--selected .appui-listview-item__title,
.unipalette__results .unity-collection-view__item--selected .appui-listview-item__subtitle,
.unipalette__results .unity-collection-view__item--selected .unipalette__row-indicator {
    color: white;
}

.unipalette__message {
    margin: 4px 16px;
    font-size: 11px;
    flex-shrink: 0;
    white-space: normal;
}

.unipalette__hints {
    margin: 0;
    padding: 7px 12px;
    font-size: 10px;
    color: var(--appui-foregrounds-50);
    white-space: normal;
    border-top-width: 1px;
    border-top-color: var(--appui-backgrounds-300);
    flex-shrink: 0;
}
